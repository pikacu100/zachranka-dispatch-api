{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Local API + SQLite",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Dispatch.Api/bin/Debug/net9.0/Dispatch.Api.dll",
            "cwd": "${workspaceFolder}/src/Dispatch.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5007",
                "Database__Provider": "Sqlite"
            }
        },
        {
            // API runs here with the debugger (port 5007); only the database is in Docker: docker compose up -d postgres
            "name": "Local API + PostgreSQL (Docker)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Dispatch.Api/bin/Debug/net9.0/Dispatch.Api.dll",
            "cwd": "${workspaceFolder}/src/Dispatch.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5007",
                "Database__Provider": "Postgres",
                "ConnectionStrings__Postgres": "Host=localhost;Port=5432;Database=dispatch;Username=dispatch;Password=dispatch"
            }
        },
        {
            // SQL Server LocalDB, already installed on this PC; the database is created by migrations
            "name": "Local API + MSSQL LocalDB",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Dispatch.Api/bin/Debug/net9.0/Dispatch.Api.dll",
            "cwd": "${workspaceFolder}/src/Dispatch.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5007",
                "Database__Provider": "SqlServer",
                "ConnectionStrings__SqlServer": "Server=(localdb)\\MSSQLLocalDB;Database=dispatch;Trusted_Connection=True;TrustServerCertificate=True"
            }
        },
        {
            "name": "Attach to running process",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
